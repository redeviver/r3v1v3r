#!/bin/bash

# Cores estilo cyberpunk
GREEN="\033[1;32m"
CYAN="\033[1;36m"
MAGENTA="\033[1;35m"
RED="\033[1;31m"
RESET="\033[0m"

function banner() {
    clear
    echo -e "${MAGENTA}"
    echo "╔══════════════════════════════╗"
    echo "║      VPSPACK CYBER EDITION   ║"
    echo "╚══════════════════════════════╝"
    echo -e "${RESET}"
}

function menu() {
    echo -e "${CYAN}[1] Gerenciar Usuários${RESET}"
    echo -e "${CYAN}[2] VPN${RESET}"
    echo -e "${CYAN}[3] Tunelamento SSH${RESET}"
    echo -e "${CYAN}[4] Monitoramento${RESET}"
    echo -e "${RED}[0] Sair${RESET}"
}

while true; do
    banner
    menu
    read -p "Escolha: " op

    case $op in
        1) bash modules/users.sh ;;
        2) bash modules/vpn.sh ;;
        3) bash modules/ssh_tunnel.sh ;;
        4) speedtest ;;
        0) exit ;;
        *) echo "Opção inválida"; sleep 1 ;;
    esac
done
